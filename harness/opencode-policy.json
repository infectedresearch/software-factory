{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    { "action": "tool.use", "resource": "external_directory:*", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:/srv/factory/operator/tmp/*", "effect": "allow" },

    { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*operator.local.md", "effect": "deny" },

    { "action": "tool.use", "resource": "edit:*opencode.json*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.opencode/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*bots_config.json*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*android-release.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:runtime/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:logs/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:scripts/grok_*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:scripts/ship*.py", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:studio_dev_deploy.py", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*studio_dev_deploy*", "effect": "deny" },

    { "action": "tool.use", "resource": "shell:ssh *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:scp *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sftp *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rsync *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:su *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:systemctl *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:systemd-run *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:crontab *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:kill *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pkill *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:killall *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:curl *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:wget *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git rebase *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git switch *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git worktree *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch -D *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit --amend*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git checkout master*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*ship.py*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*eval.py*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*benchmark*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*redis-cli*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*fracktron.com-pkey*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*operator.local*", "effect": "deny" }
  ]
}
